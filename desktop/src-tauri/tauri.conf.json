{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Working Notes",
  "version": "../../package.json",
  "identifier": "dev.jweatherby.working-notes",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A local, structured notebook that your AI assistant writes to over MCP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/wnotes"
    ],
    "resources": {
      "resources/migrations/": "migrations/",
      "resources/VERSION": "VERSION"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
